{
  "version": 1,
  "product": "focus-resume-card",
  "scope": "trusted client IP plus product slug",
  "windowSeconds": 60,
  "response": {
    "status": 429,
    "retryAfter": "a positive integer number of seconds until another request may be made",
    "cacheControl": "no-store"
  },
  "routes": [
    {
      "id": "license-verify",
      "method": "GET",
      "path": "/products/focus-resume-card/verify",
      "allowance": 13,
      "normalStatus": 200
    },
    {
      "id": "checkout",
      "method": "GET",
      "path": "/products/focus-resume-card/checkout",
      "allowance": 7,
      "normalStatus": 303
    }
  ]
}
